From fd3612f4ab59db6dd20dc541c56d5cd7305efc88 Mon Sep 17 00:00:00 2001
From: dtagnan <dtagnan@localhost>
Date: Mon, 21 Sep 2026 09:09:46 -0400
Subject: [PATCH] Add built-in No More Heroes DXVK profile

---
 src/util/config/config.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/util/config/config.cpp b/src/util/config/config.cpp
index 2b7ced46..cd9d934b 100644
--- a/src/util/config/config.cpp
+++ b/src/util/config/config.cpp
@@ -65,6 +65,17 @@ namespace dxvk {
     /* D3D11 GAMES                                */
     /**********************************************/
 
+    /* No More Heroes
+     * Game-specific profile for stable frame pacing
+     * and reduced shader compilation contention on
+     * quad-core CPUs. */
+    { R"(\\nmh\.exe$)", {{
+      { "dxgi.maxFrameLatency",              "1" },
+      { "dxvk.numCompilerThreads",            "4" },
+      { "dxvk.enablePresentTiming",         "True" },
+      { "dxvk.enableImplicitResolves",       "True" },
+    }} },
+
     /* Batman Arkham Knight - doesn't like intel vendor id *
      *(refuses to boot if vendor isn't 0x10de or 0x1002)   */
     { R"(\\BatmanAK\.exe$)", {{
-- 
2.55.0

